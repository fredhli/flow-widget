<?xml version="1.0" encoding="utf-8"?>
<!--
    The app shell's settings screen. Deliberately the same shape as activity_config.xml —
    a scrolling column of 14sp bold labels over 16sp controls, 24dp of padding, framework
    widgets on Theme.DeviceDefault.DayNight and nothing else. Two reasons: the two screens
    are one flow (this one has a button into that one), and a plain framework layout is the
    only kind that cannot look wrong on One UI, which restyles every stock widget.

    fillViewport keeps the column top-aligned on the unfolded screen instead of letting a
    short page float. Everything is wrap_content vertically so a 130% system font scale
    grows the screen rather than clipping it.

    The root has an id because AppSettingsActivity pads it by the system bars at runtime:
    at targetSdk 36 every window is edge-to-edge with no opt-out, and a framework theme
    does not pad for that — without the listener the title sits under the status bar and
    the last control under the gesture bar (spec §5). The padding goes on the ScrollView
    so the bar regions stay the window background and the column scrolls between them.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_tap_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/tap_target_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/tap_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_tap_app"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/tap_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_tap_browser"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_tap_hint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_links_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/link_policy_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/link_chrome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_links_chrome"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/link_custom_tab"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_links_custom_tab"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/link_default_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_links_default_browser"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_links_hint"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_zoom_label"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- The four percentage labels carry no android:text: they are formatted from
             settings_zoom_pct in AppSettingsActivity, so the numbers live in
             ShellPrefs.TEXT_ZOOM_CHOICES and not in two places. -->
        <RadioGroup
            android:id="@+id/text_zoom_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/zoom_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_zoom_system"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/zoom_90"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/zoom_100"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/zoom_115"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/zoom_130"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/settings_zoom_hint"
            android:textSize="12sp" />

        <Button
            android:id="@+id/open_config"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_open_config"
            android:textSize="16sp" />

        <Button
            android:id="@+id/open_diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_open_diagnostics"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textIsSelectable="true"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
