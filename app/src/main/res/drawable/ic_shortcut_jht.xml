    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M9,3 H15 V5 H9 Z M9,3 H11 V8 H9 Z M13,3 H15 V8 H13 Z M2,8 H22 V20 H2 Z" />
</vector>
