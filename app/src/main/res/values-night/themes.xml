<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night variant of Theme.Dashboard: same items, light bar icons (the page is dark).
         Theme.Dashboard.Splash is not repeated: it is defined once in values/ and its
         colours are night-qualified in colors_shell.xml. -->
    <style name="Theme.Dashboard" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/shell_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
    </style>
</resources>
